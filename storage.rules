rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /exercise-webp/{fileName} {
      allow read: if request.auth != null;
    }
    match /backups/{userId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Legacy names stay allowed so older app versions can still back up.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('^(userData\\.db(-wal|-shm)?|slotA\\.db|slotB\\.db|manifest\\.json)$')
        && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
