rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function areFriends(uid1, uid2) {
      return exists(/databases/$(database)/documents/users/$(uid1)/friends/$(uid2));
    }

    // Returns true only when a friendRequest document from→to exists with status "pending"
    // and the stored from/to fields match the expected UIDs (defence-in-depth).
    function hasPendingRequest(fromUid, toUid) {
      let doc = get(/databases/$(database)/documents/friendRequests/$(fromUid + '_' + toUid));
      return doc != null &&
             doc.data.status == 'pending' &&
             doc.data.from == fromUid &&
             doc.data.to == toUid;
    }

    // ── shared-content shape checks ──────────────────────────────────────────
    //
    // Rules have no byte-size API, so these bound what can be bounded: the
    // fields a document may carry, the length of its name, and the length of
    // the lists a runaway client could grow without limit. The byte budget
    // itself is enforced client-side (assertWithinSizeBudget in utils/sharing.ts)
    // and ultimately by Firestore's own 1MiB document limit.
    //
    // Every allowlist covers the union of fields written by all app versions
    // still installed. hasOnly() permits a subset, so a client that stops
    // writing a field (e.g. publishedAt on re-publish) keeps working.

    function boundedString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function boundedName() {
      return boundedString(request.resource.data.name, 200);
    }

    function boundedList(field, maxLength) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is list &&
              request.resource.data[field].size() <= maxLength);
    }

    function hasOnlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // Public profiles: any authenticated user can read (email search).
    // Owner can write, and only the four profile fields the app maintains.
    match /users/{uid} {
      // Single-document reads (friend profiles, search result hydration) stay open.
      allow get: if signedIn();
      // List/query reads (e.g. email search) are capped per call so the
      // collection can't be bulk-scraped for every user's email/displayName.
      allow list: if signedIn() && request.query.limit <= 5;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        hasOnlyFields(['displayName', 'email', 'photoURL', 'createdAt']) &&
        boundedString(request.resource.data.displayName, 100) &&
        boundedString(request.resource.data.photoURL, 2048) &&
        (!('email' in request.resource.data) ||
         boundedString(request.resource.data.email, 320));
      allow delete: if signedIn() && request.auth.uid == uid;

      // Private settings: owner only
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Friends subcollection.
      // Readable by owner or the named friend.
      // The owner maintains their own list. The named friend (friendUid) may
      // only create if the owner previously sent them a pending request —
      // hasPendingRequest(uid, friendUid) checks friendRequests/{uid}_{friendUid}.
      // Either party may delete, which is needed for mutual removal.
      match /friends/{friendUid} {
        allow read: if signedIn() &&
          (request.auth.uid == uid || request.auth.uid == friendUid);
        allow create: if signedIn() &&
          (request.auth.uid == uid ||
           (request.auth.uid == friendUid && hasPendingRequest(uid, friendUid))) &&
          hasOnlyFields(['since', 'displayName', 'email', 'photoURL']) &&
          boundedString(request.resource.data.displayName, 100) &&
          boundedString(request.resource.data.photoURL, 2048);
        allow update: if signedIn() && request.auth.uid == uid &&
          hasOnlyFields(['since', 'displayName', 'email', 'photoURL']) &&
          boundedString(request.resource.data.displayName, 100) &&
          boundedString(request.resource.data.photoURL, 2048);
        allow delete: if signedIn() &&
          (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      // All shared-content subcollections: owner or friends can read, owner can write.
      match /sharedPlans/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || areFriends(uid, request.auth.uid));
        allow create, update: if signedIn() && request.auth.uid == uid &&
          hasOnlyFields(['localPlanId', 'name', 'imageUrl', 'publishedAt', 'updatedAt', 'workouts']) &&
          boundedName() &&
          boundedList('workouts', 50);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /sharedStandaloneWorkouts/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || areFriends(uid, request.auth.uid));
        allow create, update: if signedIn() && request.auth.uid == uid &&
          hasOnlyFields(['localWorkoutId', 'name', 'imageUrl', 'publishedAt', 'updatedAt', 'exercises']) &&
          boundedName() &&
          boundedList('exercises', 100);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /sharedCustomExercises/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || areFriends(uid, request.auth.uid));
        allow create, update: if signedIn() && request.auth.uid == uid &&
          hasOnlyFields(['localExerciseId', 'name', 'equipment', 'bodyPart', 'targetMuscle',
                         'secondaryMuscles', 'description', 'trackingType', 'isUnilateral',
                         'doubleWeight', 'animatedUrl', 'publishedAt', 'updatedAt']) &&
          boundedName() &&
          boundedList('secondaryMuscles', 30);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /sharedWorkouts/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || areFriends(uid, request.auth.uid));
        allow create, update: if signedIn() && request.auth.uid == uid &&
          hasOnlyFields(['localWorkoutId', 'planName', 'workoutName', 'dateCompleted',
                         'durationSeconds', 'totalSetsCompleted', 'isDeload', 'exercises']) &&
          boundedList('exercises', 100);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /sharedMeasurements/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || areFriends(uid, request.auth.uid));
        allow create, update: if signedIn() && request.auth.uid == uid &&
          hasOnlyFields(['localEntryId', 'recordedAt', 'values']) &&
          request.resource.data.values is map &&
          request.resource.data.values.size() <= 100;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /sharedStrength/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || areFriends(uid, request.auth.uid));
        allow create, update: if signedIn() && request.auth.uid == uid &&
          hasOnlyFields(['exerciseName', 'appExerciseId', 'trackingType', 'allTimePR',
                         'allTimePRDate', 'topPRSets']) &&
          boundedString(request.resource.data.exerciseName, 200) &&
          boundedList('topPRSets', 20);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Friend requests.
    // Sender creates with a fixed id = from_to, status must be "pending".
    // Re-sending after accept/decline uses .set() which triggers update, handled
    // by the sender re-send branch below.
    // Only receiver can flip status from "pending" → "accepted"/"declined".
    match /friendRequests/{requestId} {
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.from &&
        requestId == request.resource.data.from + '_' + request.resource.data.to &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        hasOnlyFields(['from', 'to', 'status', 'createdAt']);
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.from ||
         request.auth.uid == resource.data.to);
      allow update: if signedIn() &&
        (
          // receiver accepts or declines a pending request
          (request.auth.uid == resource.data.to &&
           resource.data.status == 'pending' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
           (request.resource.data.status == 'accepted' ||
            request.resource.data.status == 'declined'))
          ||
          // sender re-sends after accept/decline (.set() on existing doc = update);
          // from/to must be unchanged and new status must be "pending"
          (request.auth.uid == resource.data.from &&
           resource.data.status != 'pending' &&
           request.resource.data.from == resource.data.from &&
           request.resource.data.to == resource.data.to &&
           request.resource.data.status == 'pending' &&
           hasOnlyFields(['from', 'to', 'status', 'createdAt']))
        );
      // Either party may delete. Derived from the id so it also works when the
      // document does not exist (resource is null for missing docs). Firebase
      // UIDs never contain underscores.
      allow delete: if signedIn() &&
        (requestId.split('_')[0] == request.auth.uid ||
         requestId.split('_')[1] == request.auth.uid);
    }
  }
}
