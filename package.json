{
  "name": "musclequest",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "APP_VARIANT=development npx expo start",
    "build-dev": "eas build --profile development --platform android",
    "build-preview": "eas build --profile preview --platform android",
    "build": "eas build --profile production --platform android",
    "build:local-e2e": "scripts/build-local-android.sh e2e",
    "build:local-dev": "scripts/build-local-android.sh dev",
    "update": "EAS_UPDATE_CHANNEL=production node scripts/bugsnag-eas-update-upload.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test-watchAll": "jest --watchAll",
    "lint": "expo lint",
    "lint:ci": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "eas-build-on-success": "node scripts/bugsnag-eas-upload.js",
    "extract": "lingui extract",
    "compile": "lingui compile",
    "test:rules": "firebase emulators:exec --only firestore --project demo-musclequest \"jest --config jest.rules.config.js\"",
    "test:e2e": "eas workflow:run .eas/workflows/e2e-android.yml -F suite=smoke",
    "test:e2e:full": "eas workflow:run .eas/workflows/e2e-android.yml -F suite=full",
    "test:e2e-existing": "sh -c 'eas workflow:run .eas/workflows/e2e-android-test.yml -F build_id=\"$0\" -F suite=smoke'",
    "test:e2e-existing:full": "sh -c 'eas workflow:run .eas/workflows/e2e-android-test.yml -F build_id=\"$0\" -F suite=full'"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFiles": [
      "./jestSetupFile.js"
    ],
    "setupFilesAfterEnv": [
      "./jestAfterEnvSetup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/rules-tests/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?@?react-native|@react-navigation|expo(nent)?|@expo(nent)?/.*|react-native|@react-native(-community)?/.*|p-limit|yocto-queue)"
    ],
    "moduleNameMapper": {
      "\\.db$": "<rootDir>/__mocks__/fileMocks.js"
    },
    "collectCoverageFrom": [
      "{app,components,hooks,utils,store,context,constants,theme}/**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.d.ts",
      "!utils/db/testing/**"
    ],
    "coverageThreshold": {
      "./store/": {
        "lines": 82,
        "branches": 73
      },
      "./utils/db/": {
        "lines": 84,
        "branches": 77
      },
      "./utils/": {
        "lines": 90,
        "branches": 84
      },
      "./hooks/": {
        "lines": 78,
        "branches": 69
      }
    }
  },
  "dependencies": {
    "@bugsnag/expo": "^54.0.0",
    "@bugsnag/expo-performance": "^54.0.0",
    "@bugsnag/plugin-react-navigation-performance": "^3.4.1",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/app-check": "23.8.8",
    "@react-native-firebase/auth": "^23.8.8",
    "@react-native-firebase/crashlytics": "^23.8.8",
    "@react-native-firebase/firestore": "^23.8.8",
    "@react-native-firebase/storage": "^23.8.8",
    "@react-native-google-signin/google-signin": "^12.2.1",
    "@react-navigation/native": "^7.0.14",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.5",
    "date-fns": "^3.6.0",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-insights": "~0.10.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "fuse.js": "^7.5.0",
    "p-limit": "^6.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-element-dropdown": "^2.12.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sortables": "^1.10.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-timer-hook": "^3.0.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@bugsnag/plugin-expo-eas-sourcemaps": "^54.1.0",
    "@bugsnag/source-maps": "^2.3.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lingui/babel-plugin-lingui-macro": "^6.10.1",
    "@lingui/cli": "^6.10.1",
    "@lingui/metro-transformer": "^6.10.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.5",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.11",
    "baseline-browser-mapping": "^2.10.27",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "firebase": "^12.19.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
